generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  pending
  reviewed
  accepted
  rejected
  completed
}

enum ApplicationSource {
  internship
  course
}

enum PaymentMethod {
  upi
}

enum PaymentStatus {
  pending
  verified
  rejected
}

enum CertificateStatus {
  valid
  revoked
}

model Program {
  id          String   @id @default(uuid())
  title       String
  description String
  duration    String   @default("8-12 weeks")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  batches     Batch[]

  @@map("programs")
}

model Batch {
  id           String                   @id @default(uuid())
  programId    String
  program      Program                  @relation(fields: [programId], references: [id], onDelete: Restrict)
  programTitle String
  name         String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @default(now()) @updatedAt
  applications InternshipApplication[]

  @@index([programId, startDate])
  @@map("batches")
}

model InternshipApplication {
  id                    String             @id @default(uuid())
  applicationId         String?            @unique
  fullName              String
  email                 String
  phone                 String
  college               String             @default("")
  registrationNo        String             @default("")
  department            String             @default("")
  internshipStartDate   DateTime?
  internshipEndDate     DateTime?
  batchId               String?
  batch                 Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  program               String
  message               String             @default("")
  source                ApplicationSource  @default(internship)
  feeAmount             Float              @default(0)
  paymentMethod         PaymentMethod?
  paymentTransactionId  String?            @unique
  paymentScreenshotData String?            @db.Text
  paymentStatus         PaymentStatus?
  paymentVerifiedAt     DateTime?
  status                ApplicationStatus  @default(pending)
  completedAt           DateTime?
  certificateEmailedAt  DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @default(now()) @updatedAt
  certificate           Certificate?
  offerLetter           OfferLetter?

  @@index([batchId])
  @@index([email])
  @@index([status])
  @@index([program])
  @@map("internship_applications")
}

model Certificate {
  id                String                  @id @default(uuid())
  certNo            String                  @unique
  recipientName     String
  registrationNo    String                  @default("")
  department        String                  @default("")
  college           String                  @default("")
  internshipDomain  String
  startDate         DateTime
  endDate           DateTime
  applicationId     String?                 @unique
  application       InternshipApplication?  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  status            CertificateStatus       @default(valid)
  issuedAt          DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @default(now()) @updatedAt

  @@map("certificates")
}

model OfferLetter {
  id             String                 @id @default(uuid())
  applicationId  String                 @unique
  application    InternshipApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationRef String
  recipientName  String
  program        String
  filename       String
  storagePath    String?
  pdfBytes       Bytes?
  emailedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @default(now()) @updatedAt

  @@map("offer_letters")
}

model Contact {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  whatsapp    String
  internship  String
  message     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("contacts")
}

model SequenceCounter {
  key   String @id
  value Int    @default(0)

  @@map("sequence_counters")
}
